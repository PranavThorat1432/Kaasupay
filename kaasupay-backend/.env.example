# Scheduled AutoPay Cron Authentication
# Required in production for authenticating scheduled cron invocations (e.g. from Vercel Cron).
# Must be configured in your production deployment environment.
CRON_SECRET=

# AutoPay Time Travel Configuration
# Testing and development only (?date=YYYY-MM-DD parameter for cron simulation).
# MUST remain false or omitted in production. Production startup refuses to boot if set to true.
ALLOW_TIME_TRAVEL=false
